---
// The structured form of a movie's data, one hidden <section> per facet.
// Every movie gets the same markup (not just Alien): the payoff of
// extraction is that all 12 cards reveal their matching section in sync the
// moment that facet completes in the panel, not just the one being worked on.
import { formatReleaseDate } from "../lib/format-date";
import type { MovieRecord } from "../types/movie";

interface Props {
  movie: MovieRecord;
}

const { movie } = Astro.props;
const { data } = movie;
const posterSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${data.poster.url.replace(/^\//, "")}`;
---

<div class="structured-facts" data-movie={movie.id}>
  <section data-facet="media" hidden class="poster">
    <img src={posterSrc} alt={data.poster.alt} />
    <p class="credit">{data.poster.credit}</p>
  </section>

  <div class="facts-details">
    <div class="fact-row">
      <section data-facet="releaseDate" hidden>
        <p><strong>Release date:</strong> {formatReleaseDate(data.releaseDate)}</p>
      </section>

      <section data-facet="genre" hidden>
        <p><strong>Genre:</strong> {data.genres.join(", ")}</p>
      </section>
    </div>

    <section data-facet="director" hidden>
      <p><strong>Director:</strong> {data.director.join(", ")}</p>
    </section>

    <section data-facet="component" hidden>
      <p><strong>Cast:</strong></p>
      <ul>
        {
          data.cast.map((c) => (
            <li>
              {c.actor} as {c.character}
            </li>
          ))
        }
      </ul>
    </section>

    <section data-facet="plot" hidden>
      <p><strong>Plot:</strong> {data.plot}</p>
    </section>
  </div>
</div>
