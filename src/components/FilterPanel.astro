---
// Catalog-wide filters, unlocked by completing the matching facet in the
// panel. Media and Plot don't unlock a control here at all — their payoff is
// the per-card reveal in StructuredFacts.
import { movies, PANEL_MOVIE_ID } from "../data/movies";

const gridMovies = movies.filter((m) => m.id !== PANEL_MOVIE_ID);
const genres = [...new Set(gridMovies.flatMap((m) => m.data.genres))].sort();
const directors = [...new Set(gridMovies.flatMap((m) => m.data.director))].sort();
---

<aside class="filter-panel" aria-label="Filters" hidden>
  <fieldset data-control="genre" hidden class="filter-group">
    <legend>Genre</legend>
    {
      genres.map((genre) => (
        <label class="filter-option">
          <input type="checkbox" name="genre" value={genre} />
          {genre}
        </label>
      ))
    }
  </fieldset>
  <fieldset data-control="director" hidden class="filter-group">
    <legend>Director</legend>
    {
      directors.map((director) => (
        <label class="filter-option">
          <input type="checkbox" name="director" value={director} />
          {director}
        </label>
      ))
    }
  </fieldset>
</aside>
