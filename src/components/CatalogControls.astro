---
// Catalog-wide controls, unlocked by completing the matching facet in the
// panel. The search box is the one exception: title is plain text on every
// card regardless of extraction, so it's live from the start; completing
// Component just widens what it matches (adds actor/character names)
// instead of adding a second search box. Media and Plot don't unlock a
// control here at all — their payoff is the per-card reveal in
// StructuredFacts.
import { movies, PANEL_MOVIE_ID } from "../data/movies";

const gridMovies = movies.filter((m) => m.id !== PANEL_MOVIE_ID);
const genres = [...new Set(gridMovies.flatMap((m) => m.data.genres))].sort();
const directors = [...new Set(gridMovies.flatMap((m) => m.data.director))].sort();
---

<div class="catalog-controls">
  <div class="search-control">
    <label for="catalog-search">Search</label>
    <input type="search" id="catalog-search" placeholder="Search by title…" autocomplete="off" />
  </div>

  <aside class="filter-panel" aria-label="Filters">
    <section data-control="releaseDate" hidden>
      <label>
        <input type="checkbox" id="sort-toggle" />
        Sort by release date (oldest → newest)
      </label>
    </section>

    <section data-control="taxonomy" hidden class="taxonomy-filters">
      <div>
        <label for="genre-filter">Genre</label>
        <select id="genre-filter" multiple size={Math.min(genres.length, 6)}>
          {genres.map((genre) => <option value={genre}>{genre}</option>)}
        </select>
      </div>
      <div>
        <label for="director-filter">Director</label>
        <select id="director-filter" multiple size={Math.min(directors.length, 6)}>
          {directors.map((director) => <option value={director}>{director}</option>)}
        </select>
      </div>
    </section>
  </aside>
</div>
