---
// Unlocked by completing the releaseDate facet in the panel. Once unlocked,
// the grid sorts by the selected criterion immediately — no separate
// "unsorted" state, "Title" is just the default option.
---

<div class="sort-control" data-control="releaseDate" hidden>
  <label for="sort-select"><strong>Sort by:</strong></label>
  <select id="sort-select">
    <option value="title">Title</option>
    <option value="release">Release</option>
  </select>
</div>
