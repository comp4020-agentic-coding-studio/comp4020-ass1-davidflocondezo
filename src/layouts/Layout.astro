---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const faviconSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={faviconSrc} />
  </head>
  <body>
    <slot />
  </body>
</html>
