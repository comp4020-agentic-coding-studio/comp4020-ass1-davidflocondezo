---
import Layout from "../layouts/Layout.astro";
import MoviePanel from "../components/MoviePanel.astro";
import MovieCard from "../components/MovieCard.astro";
import FilterPanel from "../components/FilterPanel.astro";
import SearchControl from "../components/SearchControl.astro";
import SortControl from "../components/SortControl.astro";
import StepGuidance from "../components/StepGuidance.astro";
import { movies, PANEL_MOVIE_ID } from "../data/movies";

const panelMovie = movies.find((m) => m.id === PANEL_MOVIE_ID);
if (!panelMovie) throw new Error("PANEL_MOVIE_ID doesn't match a movie");
const gridMovies = movies.filter((m) => m.id !== PANEL_MOVIE_ID);
---

<Layout title="Content modelling, worked through one movie">
  <header>
    <nav aria-label="Primary"></nav>
  </header>
  <main>
    <h1>Content modelling, worked through one movie</h1>
    <p class="page-intro">
      Content modelling is the process of analysing your website content and breaking it down into distinct
      structured pieces a system can use.
    </p>

    <div class="catalog-layout no-filters">
      <div class="layout-spacer" aria-hidden="true"></div>
      <div class="panel-topbar">
        <SearchControl />
        <SortControl />
      </div>
      <FilterPanel />

      <div class="catalog-content">
        <StepGuidance />
        <MoviePanel movie={panelMovie} />

        <ul class="movie-grid">
          {gridMovies.map((movie) => <MovieCard movie={movie} />)}
        </ul>
      </div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
